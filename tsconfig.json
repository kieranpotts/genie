{
  // Type-checking only. We never emit: Pi (and Node's type stripping) run the
  // TypeScript directly, so this is a CHECK step, not a build step. See
  // `run/typecheck` and AGENTS.md.
  "compilerOptions": {
    "noEmit": true,

    // Match how Pi and Node load the code: ESM, NodeNext resolution, and
    // explicit `.ts` import specifiers (which Node's type stripping requires).
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "lib": ["es2023"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,

    // Strictness — the point of adding a typechecker at all.
    "strict": true,
    "noImplicitOverride": true,
    // NOTE: `noUncheckedIndexedAccess` is intentionally OFF for now. Enabling it
    // surfaces ~20 latent `T | undefined` index-access findings across existing
    // code (incl. WIP `realize`); adopt it as a separate cleanup once those are
    // addressed.

    // Skip checking declaration files in node_modules (Pi ships a large surface;
    // we type-check our own code against it, not it against itself).
    "skipLibCheck": true,

    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
