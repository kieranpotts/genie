#!/usr/bin/env bash

#
# Tail the audit trail, from this working tree.
#
# A THIN WRAPPER around `bin/genie --logs`, which holds the actual
# implementation, for the same reason `run/startup` is one: one implementation,
# two names, no drift between the dev loop and the installed tool.
#
# Usage: ./run/log [audit|security|all]
#
#   (no args), all   Tail both log files (default).
#   audit            Tail only audit-log/calls.jsonl -- every call, turn
#                    boundaries, model-request shapes.
#   security         Tail only secret-sentry/security.jsonl -- blocked calls
#                    and redactions.
#   -h, --help       Show `genie`'s help and exit.
#
# Requires the boundary to be up (`genie --up`) -- the log files live inside the
# pi container. See "Inspect the audit trail" in src/infrastructure/README.md for
# how to read what comes out.
#

set -euo pipefail

# Use this instead for debugging problems with the script.
#set -euxo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "${script_dir}/.." && pwd)"

exec "${repo_root}/bin/genie" --logs "$@"
