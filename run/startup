#!/usr/bin/env bash

#
# Open an interactive agent session, from this working tree.
#
# A THIN WRAPPER around `bin/genie --tui`, which holds the actual
# implementation. This exists so the dev loop keeps a familiar entry point that
# needs no install, and so there is exactly ONE implementation of the boundary
# bring-up: an installed `genie` and this script cannot drift apart, because they
# are the same code reached by two names.
#
# Usage: ./run/startup [genie-options...]
#
#   -h, --help    Show `genie`'s help and exit.
#
# Any arguments are passed through, so `./run/startup --project /path` and
# `./run/startup --model technical-lead` work as they do on `genie`.
#
# THIS NO LONGER TEARS THE STACK DOWN WHEN YOU LEAVE, which is the one behaviour
# change worth knowing if you used the previous version of this script. The
# boundary and the proxy are now persistent, so that a scripted caller sending
# several prompts does not pay a full bring-up for each one. Leaving the
# container leaves it running.
#
# Stop it explicitly:
#
#   ./bin/genie --down     (or `genie --down`, once installed)
#
# `genie --status` reports what is up, and against which project.
#

set -euo pipefail

# Use this instead for debugging problems with the script.
#set -euxo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "${script_dir}/.." && pwd)"

# `--tui` first, so an explicitly passed action wins the mutual-exclusion check
# in `genie` rather than being silently overridden — `./run/startup --down` then
# reports the conflict instead of quietly opening a session.
exec "${repo_root}/bin/genie" --tui "$@"
