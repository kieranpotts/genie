#
# Interactive shell setup for the `pi` user inside the hardened container.
#
# Installed to /home/pi/.bashrc. Bash reads this for interactive non-login
# shells, which covers both ways into the container:
#
#   docker run -it <image>            (the image's default command)
#   docker compose exec pi bash       (a shell in a running container)
#
# An entrypoint script would only cover the first.
#
# The hardened harness auto-starts from here, so an interactive session lands
# in Pi. This is DELIBERATELY done from a shell rather than by making Pi the
# container's main process: `/quit` then returns you to this shell instead of
# exiting PID 1 and stopping the container. That is the whole reason the agent
# is launched here and not from an ENTRYPOINT.
#

# Nothing below is useful to a non-interactive shell, and printing to one would
# corrupt the output of `docker compose exec pi <command>`.
case $- in
  *i*) ;;
    *) return ;;
esac

# The rootfs is read-only, so bash cannot write a history file; disable it
# rather than let every shell exit fail noisily. Shell history in a disposable
# agent container is not worth a writable mount, and the audit trails in
# /var/log/pi are the record that matters.
unset HISTFILE

PS1='\[\033[34m\]pi-container\[\033[0m\]:\w\$ '

# Land in the project, not in $HOME. The image's WORKDIR is /home/pi because
# that is the only directory guaranteed to exist at build time, but an operator
# entering the container wants to be where the work is — and starting in an
# empty home is what makes a correctly-mounted project look absent.
#
# This is the OPERATOR's working directory only, and it has no bearing on the
# agent: the agent has no shell and no local file tools, so it has no working
# directory in this container at all. Its route to the project is the `mcp_*`
# tools, which resolve inside the MCP server's container, not this one.
#
# Guarded on existence so the image still works unmounted (a plain `docker run`,
# or a compose file without the project volume), and noisy when the mount is
# missing, because silently sitting in $HOME is precisely the confusing symptom
# this exists to prevent.
project_dir="${PI_PROJECT_DIR:-/projects/active}"
if [[ -d "${project_dir}" ]]; then
  cd "${project_dir}" || true
else
  printf 'Note: %s is not mounted; staying in %s.\n' "${project_dir}" "${PWD}"
  printf 'The project is mounted by compose — check PROJECT_PATH in .env.\n\n'
fi
unset project_dir

# Start the hardened harness, then fall back to this shell when it exits.
#
# Guards:
#   -t 1              A piped or redirected interactive shell is not an operator
#                     session; do not launch an agent into it.
#   PI_AUTOSTARTED    Exported, so it is inherited by every child shell. Stops a
#                     nested `bash` — or Pi's own bash tool, were it interactive
#                     — from starting a second agent inside the first.
#   PI_AUTOSTART=0    Operator opt-out: land in the shell instead. Useful for
#                     inspecting the boundary without burning a model session.
#
if [[ -t 1 ]] && [[ -z "${PI_AUTOSTARTED:-}" ]]; then
  export PI_AUTOSTARTED=1

  if [[ "${PI_AUTOSTART:-1}" == "0" ]]; then
    harnesses
  else
    printf '\nStarting the hardened Pi harness. Use %s to return to this shell.\n' "/quit"
    printf 'Set PI_AUTOSTART=0 to land in the shell instead.\n\n'

    # Not `exec` — the shell must survive Pi so /quit has somewhere to land.
    start-pi

    # Reached once Pi exits. Show what is available, so it is obvious where you
    # are and how to get back in.
    harnesses
  fi
fi
