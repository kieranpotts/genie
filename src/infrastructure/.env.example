# =============================================================================
# Host environment contract for the secure local agent architecture.
#
# Copy this file to `.env` in the same directory and fill in the values for
# your host. `.env` is gitignored and MUST NOT be committed — it holds the
# cloud API keys that this architecture deliberately keeps OFF the agent.
#
# Where these values are consumed is noted per-variable. Nothing here is read
# by the Pi agent container directly: keys are held by the LiteLLM proxy on the
# host, and the agent is only ever given the proxy endpoint.
# =============================================================================

# -----------------------------------------------------------------------------
# Cloud model API keys — held by the LiteLLM proxy ONLY (host side).
# These are read by the proxy (src/infrastructure/proxy/), never injected into the
# pi-container. Leave a provider blank if you do not use it.
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Local inference — Ollama on the host.
# Bind Ollama to the Docker bridge gateway, NOT 0.0.0.0, so it is reachable
# from containers via the `host-gateway` alias but not from the wider network.
# OLLAMA_HOST is the address Ollama itself binds to on the host.
# -----------------------------------------------------------------------------
OLLAMA_HOST=172.17.0.1:11434

# -----------------------------------------------------------------------------
# Model proxy — LiteLLM on the host (holds the keys above).
# The pi-container is given ONLY this endpoint (via host-gateway) and no keys.
# Bind to the bridge gateway, not 0.0.0.0.
# -----------------------------------------------------------------------------
LITELLM_HOST=172.17.0.1
LITELLM_PORT=4000

# The single model endpoint the agent container is allowed to call. Resolved
# from inside the container via the host-gateway alias.
AGENT_MODEL_ENDPOINT=http://host-gateway:4000

# Proxy access token. The agent authenticates to the proxy with this — a
# low-value, rotatable shared secret that gates the proxy, deliberately NOT the
# high-value cloud keys (which never leave the host). Held by the proxy AND
# given to the agent container as its ONLY model credential. Generate a random
# value, e.g. `openssl rand -hex 32`.
LITELLM_MASTER_KEY=

# -----------------------------------------------------------------------------
# MCP gateway auth token. Guards the gateway's SSE endpoint against DNS-rebinding
# attacks; the agent's mcp-client sends it as a Bearer token. Generate a random
# value, e.g. `openssl rand -hex 32`. NOT a cloud credential.
# -----------------------------------------------------------------------------
MCP_GATEWAY_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# Project workspace — the ONE project the agent is scoped to this session.
# Bound into the MCP server (the only component with filesystem access), never
# into the pi-container. Set to an absolute host path to the project root.
# -----------------------------------------------------------------------------
PROJECT_PATH=

# -----------------------------------------------------------------------------
# Pi session storage — kept on a controlled volume OUTSIDE any project tree.
# Session JSONL contains the full conversation, including file content the
# agent read, so it is treated as sensitive (see the architecture doc).
# -----------------------------------------------------------------------------
PI_CODING_AGENT_SESSION_DIR=/home/pi/sessions

# -----------------------------------------------------------------------------
# Pi network posture — disable telemetry and startup network calls. All model
# traffic goes through the proxy endpoint above and nothing else.
# -----------------------------------------------------------------------------
PI_OFFLINE=1
